    {
      "function_v0": {
        "doc": "Purchases a listed NFT using the marketplace settlement asset.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `buyer` - Address paying for and receiving the NFT.\\n* `contract_address` - Vanity contract address identifying the sale.\\n* `expected_price` - Price the buyer expects, protecting against stale transaction data.\\n\\n# Errors\\n\\n* Fails when the marketplace is paused or `buyer` does not authorize the invocation.\\n* Fails with `MarketplaceError::SaleNotFound` when no sale exists.\\n* Fails with `MarketplaceError::SelfPurchase` when the seller is the buyer.\\n* Fails with `MarketplaceError::PriceChanged` when the listing price differs.\\n* Fails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.\\n* Fails with `MarketplaceError::SellerIndexNotFound` or\\n`MarketplaceError::SellerIndexCorrupted` when index storage is inconsistent.\\n* Fails with `MarketplaceError::ArithmeticOverflow` when fee calculations overflow.\\n* Propagates settlement-asset, treasury, strategy, cashback, and NFT transfer ",
        "name": "buy",
        "inputs": [
          {
            "doc": "",
            "name": "buyer",
            "type": "address"
          },
          {
            "doc": "",
            "name": "contract_address",
            "type": "address"
          },
          {
            "doc": "",
            "name": "expected_price",
            "type": "i128"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Pauses new sale placement and purchases while preserving cancellation.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `operator` - RBAC administrator authorizing the pause.\\n\\n# Errors\\n\\n* Fails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.\\n* Propagates authorization and role errors from the RBAC contract.\\n* Propagates pausable errors when the requested state transition is invalid.",
        "name": "pause",
        "inputs": [
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Restores sale placement and purchases after a pause.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `operator` - RBAC administrator authorizing the unpause.\\n\\n# Errors\\n\\n* Fails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.\\n* Propagates authorization and role errors from the RBAC contract.\\n* Propagates pausable errors when the requested state transition is invalid.",
        "name": "unpause",
        "inputs": [
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Replaces the marketplace implementation with installed Wasm.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `new_wasm_hash` - Installed Wasm hash selected as the new implementation.\\n* `operator` - RBAC upgrader authorizing the upgrade.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.\\n* Propagates role errors from the RBAC contract.\\n* Fails when `new_wasm_hash` does not reference installed contract Wasm.",
        "name": "upgrade",
        "inputs": [
          {
            "doc": "",
            "name": "new_wasm_hash",
            "type": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Returns the current marketplace configuration.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n\\n# Returns\\n\\nThe configured contracts, settlement asset, treasury, and protocol fee.\\n\\n# Errors\\n\\nFails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.",
        "name": "get_config",
        "inputs": [],
        "outputs": [
          {
            "udt": {
              "name": "MarketplaceConfig"
            }
          }
        ]
      }
    },
    {
      "function_v0": {
        "doc": "Returns whether sale placement and purchase are paused.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n\\n# Returns\\n\\n`true` when the marketplace is paused; otherwise `false`.\\n\\n# Errors\\n\\nFails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.",
        "name": "get_paused",
        "inputs": [],
        "outputs": [
          "bool"
        ]
      }
    },
    {
      "function_v0": {
        "doc": "Cancels a sale and returns the escrowed NFT to its seller.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `contract_address` - Vanity contract address identifying the sale.\\n* `operator` - Seller authorizing cancellation.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `MarketplaceError::SaleNotFound` when no sale exists.\\n* Fails with `MarketplaceError::IncorrectSeller` when `operator` is not the seller.\\n* Fails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.\\n* Fails with `MarketplaceError::SellerIndexNotFound` or\\n`MarketplaceError::SellerIndexCorrupted` when index storage is inconsistent.\\n* Propagates NFT transfer errors.",
        "name": "cancel_sale",
        "inputs": [
          {
            "doc": "",
            "name": "contract_address",
            "type": "address"
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Returns the active sale for a vanity contract address, if one exists.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `contract_address` - Vanity contract address used as the listing key.\\n\\n# Returns\\n\\nThe active listing, or `None` when the address is not for sale.\\n\\n# Errors\\n\\n* Fails with `MarketplaceError::SellerIndexNotFound` when an active listing has\\nlost its seller index.\\n* Fails with `MarketplaceError::SaleNotFound` or\\n`MarketplaceError::SellerIndexCorrupted` when adjacent index records are invalid.",
        "name": "get_listing",
        "inputs": [
          {
            "doc": "",
            "name": "contract_address",
            "type": "address"
          }
        ],
        "outputs": [
          {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Listing"
                }
              }
            }
          }
        ]
      }
    },
    {
      "function_v0": {
        "doc": "Changes the treasury that receives protocol fees from future purchases.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `treasury` - New protocol fee recipient.\\n* `operator` - RBAC administrator authorizing the update.\\n\\n# Errors\\n\\n* Fails with `MarketplaceError::ConfigNotFound` when configuration is unavailable.\\n* Propagates authorization and role errors from the RBAC contract.",
        "name": "set_treasury",
