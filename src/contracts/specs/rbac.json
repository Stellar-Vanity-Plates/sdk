      "function_v0": {
        "doc": "Replaces the address assigned to the minter role.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `new_minter` - Address assigned as the new minter.\\n* `operator` - Current administrator authorizing the update.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `RbacError::RoleNotFound` when the administrator role is unavailable.\\n* Fails with `RbacError::Unauthorized` when `operator` is not the administrator.",
        "name": "set_minter",
        "inputs": [
          {
            "doc": "",
            "name": "new_minter",
            "type": "address"
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
