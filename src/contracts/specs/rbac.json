      "function_v0": {
        "doc": "Accepts an active administrator proposal for the proposed address.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `operator` - Proposed administrator accepting the role.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `RbacError::PendingAdminNotFound` when no proposal exists.\\n* Fails with `RbacError::PendingAdminMismatch` when `operator` was not proposed.",
        "name": "accept_admin",
        "inputs": [
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
