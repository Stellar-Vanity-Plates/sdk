      "function_v0": {
        "doc": "Replaces the RBAC implementation with installed Wasm.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `new_wasm_hash` - Installed Wasm hash selected as the new implementation.\\n* `operator` - RBAC upgrader authorizing the upgrade.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `RbacError::RoleNotFound` when the upgrader role is unavailable.\\n* Fails with `RbacError::Unauthorized` when `operator` is not the upgrader.\\n* Fails when `new_wasm_hash` does not reference installed contract Wasm.",
        "name": "upgrade",
        "inputs": [
          {
            "doc": "",
            "name": "new_wasm_hash",
            "type": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Returns the address currently assigned to a role.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `role` - Role whose assigned address is requested.\\n\\n# Returns\\n\\nThe address assigned to `role`.\\n\\n# Errors\\n\\nFails with `RbacError::RoleNotFound` when the role has no assignment.",
        "name": "get_role",
        "inputs": [
          {
            "doc": "",
            "name": "role",
            "type": {
              "udt": {
                "name": "Role"
              }
            }
          }
        ],
        "outputs": [
          "address"
        ]
      }
    },
    {
      "function_v0": {
        "doc": "Checks whether an operator is assigned to a role without requiring authorization.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `role` - Role to check.\\n* `operator` - Address compared with the current role assignment.\\n\\n# Returns\\n\\n`true` when `operator` is assigned to `role`; otherwise `false`.\\n\\n# Errors\\n\\nFails with `RbacError::RoleNotFound` when the role has no assignment.",
        "name": "has_role",
        "inputs": [
          {
            "doc": "",
            "name": "role",
            "type": {
              "udt": {
                "name": "Role"
              }
            }
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": [
          "bool"
        ]
      }
    },
