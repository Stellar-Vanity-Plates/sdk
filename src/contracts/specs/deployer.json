      "function_v0": {
        "doc": "Initializes the deployer with its shared RBAC contract.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `rbac` - RBAC contract used for administrative checks.\\n* `operator` - RBAC administrator authorizing construction.\\n\\n# Errors\\n\\nPropagates authorization and role errors from the RBAC contract.",
        "name": "__constructor",
        "inputs": [
          {
