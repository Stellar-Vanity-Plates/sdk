      "function_v0": {
        "doc": "Burns a vanity plate NFT and deploys its claimed contract address.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `token_id` - Vanity plate NFT proving control of the claimed address.\\n* `wasm_hash` - Installed Wasm hash used for the new contract.\\n* `constructor_args` - Arguments forwarded to the deployed contract constructor.\\n* `operator` - NFT owner authorizing the redemption and deployment.\\n\\n# Returns\\n\\nThe address of the deployed contract.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `VanityPlateDeployerError::NftNotFound` when no NFT is linked.\\n* Fails with `VanityPlateDeployerError::NotTokenOwner` when `operator` does not own it.\\n* Fails with `VanityPlateDeployerError::ClaimAddressMismatch` for an invalid claim or index.\\n* Fails with `VanityPlateDeployerError::AddressAlreadyDeployed` when occupied.\\n* Propagates NFT errors or deployment errors for invalid Wasm or constructor arguments.",
        "name": "deploy",
        "inputs": [
          {
            "doc": "",
            "name": "token_id",
            "type": "u32"
          },
          {
            "doc": "",
            "name": "wasm_hash",
            "type": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "constructor_args",
            "type": {
              "vec": {
                "element_type": "val"
              }
            }
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": [
          "address"
        ]
      }
    },
    {
      "function_v0": {
        "doc": "Returns the NFT contract linked to the deployer.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n\\n# Returns\\n\\nThe linked vanity plate NFT contract address.\\n\\n# Errors\\n\\nFails with `VanityPlateDeployerError::NftNotFound` when no NFT is linked.",
        "name": "get_nft",
        "inputs": [],
        "outputs": [
          "address"
        ]
      }
    },
    {
      "function_v0": {
        "doc": "Links the single NFT contract whose claims may be redeemed through this deployer.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `nft` - Vanity plate NFT contract to link.\\n* `operator` - RBAC administrator authorizing the link.\\n\\n# Errors\\n\\n* Fails with `VanityPlateDeployerError::RbacNotFound` when RBAC is unavailable.\\n* Fails with `VanityPlateDeployerError::NftAlreadySet` after an NFT has been linked.\\n* Fails with `VanityPlateDeployerError::InvalidNft` for a non-Wasm or mismatched NFT.\\n* Propagates authorization and role errors from the RBAC contract.",
        "name": "set_nft",
        "inputs": [
          {
            "doc": "",
            "name": "nft",
            "type": "address"
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Replaces the deployer implementation with installed Wasm.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n* `new_wasm_hash` - Installed Wasm hash selected as the new implementation.\\n* `operator` - RBAC upgrader authorizing the upgrade.\\n\\n# Errors\\n\\n* Fails when `operator` does not authorize the invocation.\\n* Fails with `VanityPlateDeployerError::RbacNotFound` when RBAC is unavailable.\\n* Propagates role errors from the RBAC contract.\\n* Fails when `new_wasm_hash` does not reference installed contract Wasm.",
        "name": "upgrade",
        "inputs": [
          {
            "doc": "",
            "name": "new_wasm_hash",
            "type": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "operator",
            "type": "address"
          }
        ],
        "outputs": []
      }
    },
    {
      "function_v0": {
        "doc": "Returns the RBAC contract used by the deployer.\\n\\n# Arguments\\n\\n* `e` - Contract execution environment.\\n\\n# Returns\\n\\nThe configured RBAC contract address.\\n\\n# Errors\\n\\nFails with `VanityPlateDeployerError::RbacNotFound` when RBAC is unavailable.",
        "name": "get_rbac",
        "inputs": [],
        "outputs": [
          "address"
        ]
      }
    },
