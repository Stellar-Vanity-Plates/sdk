{
  "name": "@vanity-plates/sdk",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./farming": "./src/farming/index.ts",
    "./accounts": "./src/accounts/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./rendering": "./src/rendering/index.ts",
    "./png": "./src/rendering/png.ts",
    "./web": "./src/web/index.ts",
    "./react": "./src/react/index.tsx",
    "./png/server": "./src/rendering/png-server.ts",
    "./contracts/nft": "./src/contracts/nft/index.ts",
    "./contracts/deployer": "./src/contracts/deployer/index.ts",
    "./contracts/marketplace": "./src/contracts/marketplace/index.ts",
    "./contracts/treasury": "./src/contracts/treasury/index.ts",
    "./contracts/rbac": "./src/contracts/rbac/index.ts",
    "./colibri": "./src/colibri.ts",
    "./rendering/local": "./src/rendering/local/index.ts",
    "./rendering/styles": "./src/rendering/styles/index.ts",
    "./react/styles": "./src/react/styles/index.tsx"
  },
  "imports": {
    "@colibri/core": "jsr:@colibri/core@^1.2.0",
    "@colibri/identicon": "jsr:@colibri/identicon@1.1.0",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "react": "npm:react@^19.1.1",
    "react/jsx-runtime": "npm:react@^19.1.1/jsx-runtime",
    "@types/react": "npm:@types/react@^19.1.13",
    "@stellar/stellar-sdk": "npm:@stellar/stellar-sdk@17.0.1",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "@types/react-dom/client": "npm:@types/react-dom@19.2.3/client",
    "react-dom/server": "npm:react-dom@19.3.0/server",
    "@types/react-dom/server": "npm:@types/react-dom@19.2.3/server",
    "@/": "./src/",
    "@tests/": "./tests/",
    "@examples/": "./examples/",
    "@tools/": "./tools/",
    "@sdk": "./index.ts",
    "playwright": "npm:playwright@1.61.0",
    "pngjs": "npm:pngjs@7.0.0",
    "@types/pngjs": "npm:@types/pngjs@6.0.5",
    "postcss": "npm:postcss@8.5.6",
    "@reference/": "./tests/reference/webapp/",
    "@config": "./deno.json",
    "@colibri/contract-bindings": "jsr:@colibri/contract-bindings@0.1.0",
    "@std/testing": "jsr:@std/testing@1.0.19",
    "crap4ts-tool": "npm:@alperlabs/crap4ts@0.2.1",
    "typescript": "npm:typescript@5.9.3",
    "react-test-renderer": "npm:react-test-renderer@19.3.0",
    "@types/react-test-renderer": "npm:@types/react-test-renderer@19.1.0",
    "happy-dom": "npm:happy-dom@20.14.5",
    "@colibri/core/strkey": "jsr:@colibri/core@^1.2.0/strkey",
    "@colibri/core/errors": "jsr:@colibri/core@^1.2.0/errors",
    "@colibri/identicon/svg": "jsr:@colibri/identicon@1.1.0/svg",
    "@tanstack/react-query": "npm:@tanstack/react-query@5.102.8"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "@types/react"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno run --allow-run tools/check-exports.ts check && deno check examples/*.ts tools/*.ts tools/lint/*.ts tools/quality/*.ts",
    "test": "deno task test:architecture && deno task test:unit && deno task test:integration && deno task test:tooling",
    "docs": "deno run --allow-run tools/check-exports.ts docs && deno task check:docs",
    "generate": "deno run --allow-read=src/contracts,tests/fixtures/contract-specs --allow-write=src/contracts --allow-run tools/generate-clients.ts",
    "build:preview": "deno bundle --platform browser --minify --code-splitting --outdir dist examples/browser.ts",
    "preview": "deno task build:preview && deno run --allow-net=127.0.0.1:4192 --allow-read=examples/index.html,dist tools/serve-preview.ts",
    "test:live": "deno run --allow-net=soroban-testnet.stellar.org examples/read-protocol.ts",
    "example:export": "deno run -A examples/export.ts",
    "example:farm": "deno run examples/farm.ts",
    "generate:styles": "deno run --allow-env=CI,FORCE_COLOR,NO_COLOR,TERM --allow-read=tests/reference/webapp/public --allow-write=src/rendering/vendor tools/generate-plate-styles.ts",
    "build:test": "deno bundle --platform browser --outdir dist/test tests/browser/consumer.ts",
    "test:browser": "deno task build:test && deno test -A tests/browser",
    "check:webapp": "deno run --allow-read --allow-run=git tools/check-webapp.ts",
    "test:architecture": "deno test --allow-read tests/architecture",
    "test:unit": "deno test --allow-read --allow-env --allow-sys --ignore=tests/architecture,tests/browser,tests/integration,tests/tooling,tests/consumers,tests/reference tests",
    "test:tooling": "deno test --allow-read --allow-env --allow-write --allow-run tests/tooling",
    "check:docs": "deno run --allow-read --allow-write --allow-run tools/check-docs.ts",
    "check:consumers": "deno run --allow-read --allow-write --allow-run tools/check-consumers.ts",
    "test:svg": "deno test --allow-read tests/svg",
    "fixtures:svg:update": "deno run --allow-read=tests/fixtures/svg --allow-write=tests/fixtures/svg tools/update-svg-fixtures.ts",
    "check:generated": "deno run --allow-read=src/contracts,tests/fixtures/contract-specs --allow-run tools/generate-clients.ts --check",
    "test:unit:coverage": "deno test --allow-read --allow-env --allow-sys --ignore=tests/architecture,tests/browser,tests/integration,tests/tooling,tests/consumers,tests/reference --coverage=coverage/unit --clean --coverage-raw-data-only tests",
    "coverage:report": "deno coverage --lcov --exclude='tests/|tools/' --output=coverage/lcov.info coverage/unit coverage/integration-rpc coverage/integration-browser && deno coverage --html --exclude='tests/|tools/' coverage/unit coverage/integration-rpc coverage/integration-browser",
    "check:coverage": "deno run --allow-read --allow-env tools/check-coverage.ts",
    "check:crap": "deno run --allow-read --allow-env tools/check-crap.ts",
    "test:coverage": "deno task test:unit:coverage && deno task coverage:unit:report && deno task check:crap coverage/unit.lcov && deno task test:integration:coverage && deno task coverage:report && deno task check:coverage && deno task check:crap",
    "test:integration:rpc": "deno test --allow-net=127.0.0.1 --allow-env --ignore=**/*.testnet.integration.test.ts tests/integration",
    "test:integration:rpc:coverage": "deno test --allow-net=127.0.0.1 --allow-env --ignore=**/*.testnet.integration.test.ts --coverage=coverage/integration-rpc --clean --coverage-raw-data-only tests/integration",
    "test:browser:coverage": "deno task build:test && deno test -A --coverage=coverage/integration-browser --clean --coverage-raw-data-only tests/browser",
    "test:integration": "deno task test:integration:rpc && deno task test:browser",
    "test:integration:coverage": "deno task test:integration:rpc:coverage && deno task test:browser:coverage",
    "test:testnet": "deno test --allow-net=soroban-testnet.stellar.org tests/integration/protocol.testnet.integration.test.ts",
    "coverage:unit:report": "deno coverage --lcov --exclude='tests/|tools/' --output=coverage/unit.lcov coverage/unit",
    "check:publish": "deno publish --dry-run --allow-dirty --frozen-lockfile",
    "release:plan": "deno run --allow-read=deno.json --allow-run=git --allow-net=jsr.io --allow-env=GITHUB_OUTPUT --allow-write tools/plan-release.ts",
    "check:consumers:published": "deno run --allow-read --allow-write --allow-run tools/check-consumers.ts --published",
    "check:bundles": "deno run --allow-read --allow-write --allow-run tools/check-bundles.ts"
  },
  "publish": {
    "include": [
      "index.ts",
      "src/",
      "README.md",
      "deno.json",
      "THIRD_PARTY_NOTICES.md",
      "CONTRIBUTING.md",
      "LICENSE"
    ]
  },
  "fmt": {
    "exclude": [
      "src/rendering/vendor/",
      "tests/reference/webapp/",
      "tests/fixtures/svg/*.svg"
    ]
  },
  "lint": {
    "exclude": [
      "src/rendering/vendor/",
      "tests/reference/webapp/"
    ],
    "plugins": [
      "./tools/lint/no-relative-imports.ts"
    ]
  },
  "exclude": [
    "dist/",
    "output/",
    "node_modules/"
  ]
}
